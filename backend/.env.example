ENVIRONMENT=DEV
DEBUG=True
BACKEND_SERVER_HOST=127.0.0.1
BACKEND_SERVER_PORT=8000
BACKEND_SERVER_WORKERS=4

# Database - MS SQL Server (the POSTGRES_* names are kept for the settings module)
POSTGRES_DB=my_db
# Keep this URL-safe (no @, :, /, #, ?) — it's interpolated verbatim into the DB URI.
POSTGRES_PASSWORD=postgres13240
POSTGRES_PORT=1433
# The backend talks to MS SQL Server through aioodbc (the only DBAPI driver in
# requirements.txt); a postgresql URI would need psycopg2, which isn't installed.
POSTGRES_SCHEMA=mssql+aioodbc
POSTGRES_USERNAME=sa
IS_ALLOWED_CREDENTIALS=True
API_TOKEN=YOUR-API-TOKEN
AUTH_TOKEN=YOUR-AUTHENTICATION-TOKEN

# BACKEND_CORS_ORIGINS=https://dashboard.example.com

# Comma-separated emails auto-promoted to admin (can assign roles via /accounts/{id}/role) on every startup.
# ADMIN_EMAILS=admin@pertamina.com

# Shared password every admin-created account starts with (no self-signup flow exists).
# DEFAULT_USER_PASSWORD=Pertamina@2026

# This is the host for Docker Postgres Image in docker-compose.yaml
POSTGRES_HOST=db
POSTGRES_URI={POSTGRES_SCHEMA}://{POSTGRES_USERNAME}:{POSTGRES_PASSWORD}@{POSTGRES_HOST}:{POSTGRES_PORT}/{POSTGRES_DB}

# Database - SQLAlchemy
DB_TIMEOUT=5
DB_POOL_SIZE=100
DB_MAX_POOL_CON=80
DB_POOL_OVERFLOW=20
DB_INIT_MODE=create
IS_DB_ECHO_LOG=True
IS_DB_EXPIRE_ON_COMMIT=False
IS_DB_FORCE_ROLLBACK=True

# JWT Token
JWT_SECRET_KEY=YOUR-JWT-SECRET-KEY
JWT_SUBJECT=YOUR-JWT-SUBJECT
JWT_TOKEN_PREFIX=Bearer
JWT_ALGORITHM=HS256
JWT_MIN=60
JWT_HOUR=23
JWT_DAY=6

# Hash Functions
HASHING_ALGORITHM_LAYER_1=bcrypt
HASHING_ALGORITHM_LAYER_2=argon2
HASHING_SALT=YOUR-RANDOM-SALTY-SALT

# Codecov (Login to COdecov and get your TOKEN)
CODECOV_TOKEN=
